# HyperQwen-Mem configuration
# Copy to `.env` and fill in. `.env` is git-ignored; this template is committed.

# Where the SQLite memory DB lives (absolute path recommended)
MEM_DB=./data/memory.db

# HTTP port for the memory service (review page + MCP endpoint)
MEM_PORT=8321

# HyperQwen (vLLM) endpoint used by the consolidation worker
HYPERQWEN_URL=http://127.0.0.1:18020

# API key for the LLM endpoint (only needed if vLLM enforces auth; can be empty for local)
HYPERQWEN_API_KEY=

# 1 = run the LLM consolidation worker (async, background). 0 = degraded mode (no LLM)
CONSOLIDATE=1

# Consolidation batch size (episodes per LLM call) and how often (seconds)
MEM_BATCH=4
MEM_BATCH_INTERVAL=30
